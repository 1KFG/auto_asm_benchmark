// auto_asm_benchmark — Nextflow DSL2 meta-harness configuration
//
// Profiles:
//   local  — run everything locally (validation / smoke tests)
//   slurm  — HPCC SLURM execution (production; benchmark processes on epyc)
//   test   — tiny synthetic fixture datasets + local executor

manifest {
  name = 'stajichlab/auto-asm-benchmark'
  author = 'Jason Stajich'
  description = 'Benchmark harness for automated fungal assembly/QC pipelines'
  version = '0.1.0'
  nextflowVersion = '!>=23.10.0'
  defaultBranch = 'main'
}

singularity {
  enabled = true
  autoMounts = true
}

process {
  executor = 'local'
  // benchmark runs are long; use generous default, overridable per-queue
  time = '24.h'
  memory = '16.GB'
  cpus = 4
  withLabel: 'benchmark' {
    cpus = 8
    memory = '32.GB'
    time = '48.h'
    errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries = 2
  }
}

params {
  // Smoke mode (harness + adapters): tiny fixtures, placeholder outputs, and
  // NO real nested pipeline runs / SLURM submission. Set true in the `test`
  // profile; adapters receive it as BENCH_SMOKE.
  smoke = false
  // Where pulled, pinned container images live (gitignored, built by
  // scripts/pull_containers.sh). Exposed to adapters as BENCH_SIFS_DIR.
  sifs_dir = "${projectDir}/containers/sifs"
}

profiles {
  local {
    process.executor = 'local'
    process.errorStrategy = 'finish'
  }

  test {
    includeConfig 'conf/profile_test.config'
  }

  slurm {
    process.executor = 'slurm'
    // clusterOptions set in conf/profile_slurm.config (avoids task.* closure in profile scope)
    includeConfig 'conf/profile_slurm.config'
  }

  // GCP stub — k8s/CEPHFS offload is intentionally NOT wired yet (ADR-005).
  // Remove the gcp profile entirely until implemented; do not add a broken one
  // that parses config but fails lazily.
}
