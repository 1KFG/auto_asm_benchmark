// Test profile: tiny local fixture datasets, no real assembly.
// Use with -profile test for validating the harness itself.

process {
  executor = 'local'
  errorStrategy = 'finish'
  memory = '1.GB'
  cpus = 1
  time = '10.min'
  withLabel: 'benchmark' {
    cpus = 2
    memory = '4.GB'
    time = '10.min'
  }
}

params {
  outdir = 'results-test'
  smoke  = true
}
