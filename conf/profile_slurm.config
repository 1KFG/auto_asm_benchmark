// SLURM profile for UCR HPCC.
// Benchmark processes use the stajichlab (long-job) queue; short jobs below 2h
// can target `short`. Adjust node/queue defaults per job class (see ADR-005).

process {
  queue = 'stajichlab'
  time = '48.h'
  memory = '32.GB'
  cpus = 8
  clusterOptions = '--ntasks=1'
}
