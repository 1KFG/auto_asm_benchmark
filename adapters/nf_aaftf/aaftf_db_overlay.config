// nf_aaftf DB-path overlay (ADR-004 workaround, pin unchanged).
// Fix: mount the host AAFTF_DB at BOTH paths so either spelling resolves.
// Kept spelling-symmetric on purpose; the moment upstream fixes the typo this
// extra mount is harmless and can be dropped.
singularity {
    runOptions = "--bind ${params.aaftf_db}:/opt/aaftf_db,${params.aaftf_db}:/opt/aaaftf_db,${params.taxondb}:${params.taxondb},/dev/shm:/dev/shm"
}
